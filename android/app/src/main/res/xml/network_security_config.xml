<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置

  策略：系统层全局允许 cleartext，应用层通过 allowHttp 开关控制
  - 系统层：cleartextTrafficPermitted="true"（Android 不阻止 HTTP）
  - 应用层：AppConfig.allowHttp 开关
    - false（默认）：JS 层 useEewStream 和原生层 EewBackgroundService 拒绝非 localhost 的 HTTP endpoint
    - true：允许所有 HTTP 连接（含公网和局域网），用于连接自建 HTTP 服务器

  设计原因：Android network_security_config 不支持 CIDR 通配符（无法配置 192.168.*.*），
  只能在系统层全局放开 cleartext，由应用层做精细控制。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
